{
	"name": "df_dim_room",
	"properties": {
		"folder": {
			"name": "DW"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_tbl_airbnb",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_dim_room",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          room_type as string,",
				"          shared_room as boolean,",
				"          private_room as boolean,",
				"          person_capacity as integer,",
				"          superhost as boolean,",
				"          multiple_rooms as integer,",
				"          business as integer,",
				"          cleanliness_rating as integer,",
				"          bedrooms as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT room_type, shared_room, private_room, person_capacity, superhost, multiple_rooms, business, cleanliness_rating, bedrooms FROM [dbo].[tbl_hechos_airbnb]',",
				"     format: 'query') ~> source1",
				"source1 sort(asc(room_type, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          room_type as string,",
				"          shared_room as boolean,",
				"          private_room as boolean,",
				"          person_capacity as integer,",
				"          superhost as boolean,",
				"          multiple_rooms as integer,",
				"          business as integer,",
				"          cleanliness_rating as integer,",
				"          bedrooms as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          room_type,",
				"          shared_room,",
				"          private_room,",
				"          person_capacity,",
				"          superhost,",
				"          multiple_rooms,",
				"          business,",
				"          cleanliness_rating,",
				"          bedrooms",
				"     )) ~> sink1"
			]
		}
	}
}